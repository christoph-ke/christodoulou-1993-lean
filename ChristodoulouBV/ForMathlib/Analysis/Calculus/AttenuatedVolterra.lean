module

public import ChristodoulouBV.ForMathlib.Analysis.Calculus.DiagonalVolterraPrimitiveBox
public import Mathlib.Analysis.SpecialFunctions.Integrals.Basic
import all ChristodoulouBV.ForMathlib.Geometry.NullTriangle
import Mathlib.Tactic

/-!
# Attenuated Volterra integrals on a coordinate triangle

This file develops estimates for a nonnegative source multiplied by the
exponential of a nonnegative Volterra primitive. The source and attenuation
kernel are arbitrary continuous functions on a closed coordinate triangle.
-/

public section

open Set MeasureTheory
open scoped Interval Topology

namespace intervalIntegral

/-- A source integrated against the attenuation generated by a second kernel. -/
@[expose] noncomputable def attenuatedVolterraIntegral
    (j k : ℝ × ℝ → ℝ) (u v : ℝ) : ℝ :=
  ∫ s in u..v, j (u, s) * Real.exp (-(∫ t in s..v, k (u, t)))

/-- The attenuated Volterra integral vanishes on the diagonal. -/
@[simp] theorem attenuatedVolterraIntegral_self (j k : ℝ × ℝ → ℝ) (u : ℝ) :
    attenuatedVolterraIntegral j k u u = 0 := by
  simp [attenuatedVolterraIntegral]

/-- The integral of the square of the distance from a fixed lower endpoint. -/
theorem integral_sq_sub_left (u v : ℝ) :
    (∫ s in u..v, (s - u) ^ 2) = (v - u) ^ 3 / 3 := by
  have h := intervalIntegral.integral_comp_add_right (f := fun x : ℝ => x ^ 2)
    (a := u) (b := v) (-u)
  simp only [sub_eq_add_neg] at h ⊢
  rw [h]
  rw [integral_pow]
  norm_num

/-- A quadratic pointwise bound integrates to an exact cubic bound. -/
theorem abs_integral_le_third_cube_of_abs_le_quadratic
    {u v A : ℝ} {g : ℝ → ℝ}
    (huv : u ≤ v)
    (hgi : IntervalIntegrable g volume u v)
    (hg : ∀ s ∈ Icc u v, |g s| ≤ A * (s - u) ^ 2) :
    |∫ s in u..v, g s| ≤ A * (v - u) ^ 3 / 3 := by
  have hmaj : IntervalIntegrable (fun s : ℝ => A * (s - u) ^ 2)
      volume u v :=
    (continuous_const.mul ((continuous_id.sub continuous_const).pow 2)).intervalIntegrable _ _
  have hu := intervalIntegral.integral_mono_on huv hgi hmaj
    (fun s hs => (abs_le.mp (hg s hs)).2)
  have hl := intervalIntegral.integral_mono_on huv hgi.neg hmaj
    (fun s hs => by
      dsimp
      exact neg_le.mpr (abs_le.mp (hg s hs)).1)
  rw [intervalIntegral.integral_const_mul, integral_sq_sub_left] at hu hl
  simp only [Pi.neg_apply, intervalIntegral.integral_neg] at hl
  exact abs_le.mpr ⟨by nlinarith only [hl], by nlinarith only [hu]⟩

/-- Attenuation cannot exceed one when the attenuation kernel is nonnegative. -/
theorem exp_neg_integral_le_one
    {a b u s v : ℝ} {k : ℝ × ℝ → ℝ}
    (hu : a ≤ u) (hus : u ≤ s) (hsv : s ≤ v) (hv : v ≤ b)
    (hk : ∀ p ∈ closedCoordTriangle a b, 0 ≤ k p) :
    Real.exp (-(∫ t in s..v, k (u, t))) ≤ 1 := by
  have hq : 0 ≤ ∫ t in s..v, k (u, t) :=
    intervalIntegral.integral_nonneg hsv (fun t ht =>
      hk (u, t) ⟨hu, hus.trans ht.1, ht.2.trans hv⟩)
  exact (Real.exp_le_one_iff).2 (neg_nonpos.mpr hq)

/-- On the nonnegative half-line, the decaying exponential is one-Lipschitz. -/
theorem abs_exp_neg_sub_exp_neg_le {x y : ℝ} (hx : 0 ≤ x) (hy : 0 ≤ y) :
    |Real.exp (-x) - Real.exp (-y)| ≤ |x - y| := by
  have hcase {r s : ℝ} (hr : 0 ≤ r) (hrs : r ≤ s) :
      Real.exp (-r) - Real.exp (-s) ≤ s - r := by
    have he : Real.exp (-s) = Real.exp (-r) * Real.exp (-(s - r)) := by
      rw [← Real.exp_add]
      congr 1
      ring
    have htail : 1 - Real.exp (-(s - r)) ≤ s - r := by
      linarith [Real.one_sub_le_exp_neg (s - r)]
    have hunit : Real.exp (-r) ≤ 1 := (Real.exp_le_one_iff).2 (neg_nonpos.mpr hr)
    have hpos : 0 ≤ 1 - Real.exp (-(s - r)) := by
      have h := (Real.exp_le_one_iff).2 (by linarith : -(s - r) ≤ 0)
      linarith
    rw [he]
    nlinarith [mul_le_mul_of_nonneg_left htail (Real.exp_pos (-r)).le,
      mul_le_mul_of_nonneg_right hunit hpos]
  rcases le_total x y with hxy | hyx
  · have hmon : Real.exp (-y) ≤ Real.exp (-x) :=
      Real.exp_le_exp.mpr (by linarith)
    rw [abs_of_nonneg (sub_nonneg.mpr hmon), abs_of_nonpos (sub_nonpos.mpr hxy)]
    simpa only [neg_sub] using hcase hx hxy
  · have hmon : Real.exp (-x) ≤ Real.exp (-y) :=
      Real.exp_le_exp.mpr (by linarith)
    rw [abs_of_nonpos (sub_nonpos.mpr hmon), abs_of_nonneg (sub_nonneg.mpr hyx)]
    simpa only [neg_sub] using hcase hy hyx

/-- A nonnegative source gives a nonnegative attenuated Volterra integral,
bounded by the cubic integral of a quadratic source majorant. -/
theorem attenuatedVolterraIntegral_nonneg_le
    {a b u v J₀ : ℝ} {j k : ℝ × ℝ → ℝ}
    (hu : a ≤ u) (huv : u ≤ v) (hv : v ≤ b)
    (hj : ContinuousOn j (closedCoordTriangle a b))
    (hkcont : ContinuousOn k (closedCoordTriangle a b))
    (hk : ∀ p ∈ closedCoordTriangle a b, 0 ≤ k p)
    (hsource : ∀ p ∈ closedCoordTriangle a b,
      0 ≤ j p ∧ j p ≤ J₀ * (p.2 - p.1) ^ 2) :
    0 ≤ attenuatedVolterraIntegral j k u v ∧
      attenuatedVolterraIntegral j k u v ≤ J₀ * (v - u) ^ 3 / 3 := by
  have hseg : ∀ s ∈ Icc u v, (u, s) ∈ closedCoordTriangle a b := by
    intro s hs
    exact ⟨hu, hs.1, hs.2.trans hv⟩
  have hqcont : ContinuousOn
      (fun p : (ℝ × ℝ) × ℝ => ∫ t in p.1.2..p.2, k (p.1.1, t))
      (closedVolterraTriple a b) :=
    continuousOn_verticalVolterraPrimitive hkcont
  have harg : ContinuousOn
      (fun s : ℝ => ((u, s), v)) (Icc u v) := by fun_prop
  have hq : ContinuousOn (fun s => ∫ t in s..v, k (u, t)) (Icc u v) :=
    hqcont.comp harg (by
      intro s hs
      exact ⟨hu, hs.1, hs.2, hv⟩)
  have hint : IntervalIntegrable
      (fun s => j (u, s) * Real.exp (-(∫ t in s..v, k (u, t))))
      volume u v := by
    apply ContinuousOn.intervalIntegrable_of_Icc huv
    exact (hj.comp (continuous_const.prodMk continuous_id).continuousOn hseg).mul
      (Real.continuous_exp.comp_continuousOn hq.neg)
  have hnonneg : 0 ≤ attenuatedVolterraIntegral j k u v := by
    exact intervalIntegral.integral_nonneg huv (fun s hs =>
      mul_nonneg (hsource _ (hseg s hs)).1 (Real.exp_pos _).le)
  have hmaj : IntervalIntegrable (fun s : ℝ => J₀ * (s - u) ^ 2)
      volume u v :=
    (continuous_const.mul ((continuous_id.sub continuous_const).pow 2)).intervalIntegrable _ _
  have hupper := intervalIntegral.integral_mono_on huv hint hmaj (by
    intro s hs
    have hsrc := hsource _ (hseg s hs)
    have he := exp_neg_integral_le_one hu hs.1 hs.2 hv hk
    have hpos : 0 ≤ Real.exp (-(∫ t in s..v, k (u, t))) := (Real.exp_pos _).le
    exact (mul_le_of_le_one_right hsrc.1 he).trans hsrc.2)
  rw [intervalIntegral.integral_const_mul, integral_sq_sub_left] at hupper
  change attenuatedVolterraIntegral j k u v ≤ J₀ * ((v - u) ^ 3 / 3) at hupper
  exact ⟨hnonneg, by nlinarith only [hupper]⟩

/-- A linearly controlled difference of attenuation kernels gives a
quadratic bound for their Volterra primitives. -/
theorem abs_attenuationPrimitive_sub_le
    {a b u s v K D : ℝ} {k₁ k₂ : ℝ × ℝ → ℝ}
    (hu : a ≤ u) (hus : u ≤ s) (hsv : s ≤ v) (hv : v ≤ b)
    (hk₁ : ContinuousOn k₁ (closedCoordTriangle a b))
    (hk₂ : ContinuousOn k₂ (closedCoordTriangle a b))
    (hK : 0 ≤ K) (hD : 0 ≤ D)
    (hbound : ∀ p ∈ closedCoordTriangle a b,
      |k₁ p - k₂ p| ≤ K * (p.2 - p.1) * D) :
    |(∫ t in s..v, k₁ (u, t)) - (∫ t in s..v, k₂ (u, t))| ≤
      K * (v - u) ^ 2 * D / 2 := by
  have hseg : ∀ t ∈ Icc s v, (u, t) ∈ closedCoordTriangle a b := by
    intro t ht
    exact ⟨hu, hus.trans ht.1, ht.2.trans hv⟩
  have hi₁ : IntervalIntegrable (fun t => k₁ (u, t)) volume s v :=
    (hk₁.comp (continuous_const.prodMk continuous_id).continuousOn hseg)
      |>.intervalIntegrable_of_Icc hsv
  have hi₂ : IntervalIntegrable (fun t => k₂ (u, t)) volume s v :=
    (hk₂.comp (continuous_const.prodMk continuous_id).continuousOn hseg)
      |>.intervalIntegrable_of_Icc hsv
  rw [← intervalIntegral.integral_sub hi₁ hi₂]
  have h := abs_integral_le_half_sq_of_abs_le_linear hsv (mul_nonneg hK hD)
    (hi₁.sub hi₂) (by
      intro t ht
      simpa only [Pi.sub_apply, mul_assoc, mul_comm, mul_left_comm] using
        hbound _ (hseg t ht))
  nlinarith only [h]

/-- The two-input cubic value estimate for attenuated Volterra integrals.
The constants are the exact coefficients obtained by integrating a quadratic
source bound and a quadratic bound for the change in attenuation. -/
theorem abs_attenuatedVolterraIntegral_sub_le
    {a b u v J₀ JΔ KΔ D : ℝ} {j₁ j₂ k₁ k₂ : ℝ × ℝ → ℝ}
    (hu : a ≤ u) (huv : u ≤ v) (hv : v ≤ b) (hsize : b - a ≤ 1)
    (hj₁ : ContinuousOn j₁ (closedCoordTriangle a b))
    (hj₂ : ContinuousOn j₂ (closedCoordTriangle a b))
    (hk₁ : ContinuousOn k₁ (closedCoordTriangle a b))
    (hk₂ : ContinuousOn k₂ (closedCoordTriangle a b))
    (hkpos₁ : ∀ p ∈ closedCoordTriangle a b, 0 ≤ k₁ p)
    (hkpos₂ : ∀ p ∈ closedCoordTriangle a b, 0 ≤ k₂ p)
    (hJ₀ : 0 ≤ J₀) (hKΔ : 0 ≤ KΔ) (hD : 0 ≤ D)
    (hsource₂ : ∀ p ∈ closedCoordTriangle a b,
      0 ≤ j₂ p ∧ j₂ p ≤ J₀ * (p.2 - p.1) ^ 2)
    (hjdifference : ∀ p ∈ closedCoordTriangle a b,
      |j₁ p - j₂ p| ≤ JΔ * (p.2 - p.1) ^ 2 * D)
    (hkdifference : ∀ p ∈ closedCoordTriangle a b,
      |k₁ p - k₂ p| ≤ KΔ * (p.2 - p.1) * D) :
    |attenuatedVolterraIntegral j₁ k₁ u v -
      attenuatedVolterraIntegral j₂ k₂ u v| ≤
      (JΔ / 3 + J₀ * KΔ / 6) * (v - u) ^ 3 * D := by
  have hseg : ∀ s ∈ Icc u v, (u, s) ∈ closedCoordTriangle a b := by
    intro s hs
    exact ⟨hu, hs.1, hs.2.trans hv⟩
  have hqcont₁ := continuousOn_verticalVolterraPrimitive hk₁
  have hqcont₂ := continuousOn_verticalVolterraPrimitive hk₂
  have harg : ContinuousOn (fun s : ℝ => ((u, s), v)) (Icc u v) := by fun_prop
  have hmap : MapsTo (fun s : ℝ => ((u, s), v))
      (Icc u v) (closedVolterraTriple a b) := by
    intro s hs
    exact ⟨hu, hs.1, hs.2, hv⟩
  have hq₁ : ContinuousOn (fun s => ∫ t in s..v, k₁ (u, t)) (Icc u v) :=
    hqcont₁.comp harg hmap
  have hq₂ : ContinuousOn (fun s => ∫ t in s..v, k₂ (u, t)) (Icc u v) :=
    hqcont₂.comp harg hmap
  have hi₁ : IntervalIntegrable
      (fun s => j₁ (u, s) * Real.exp (-(∫ t in s..v, k₁ (u, t))))
      volume u v := by
    apply ContinuousOn.intervalIntegrable_of_Icc huv
    exact (hj₁.comp (continuous_const.prodMk continuous_id).continuousOn hseg).mul
      (Real.continuous_exp.comp_continuousOn hq₁.neg)
  have hi₂ : IntervalIntegrable
      (fun s => j₂ (u, s) * Real.exp (-(∫ t in s..v, k₂ (u, t))))
      volume u v := by
    apply ContinuousOn.intervalIntegrable_of_Icc huv
    exact (hj₂.comp (continuous_const.prodMk continuous_id).continuousOn hseg).mul
      (Real.continuous_exp.comp_continuousOn hq₂.neg)
  have hd : 0 ≤ v - u ∧ v - u ≤ 1 := ⟨sub_nonneg.mpr huv, by linarith⟩
  have hd2 : (v - u) ^ 2 ≤ 1 := by nlinarith [sq_nonneg (v - u)]
  have hpoint (s : ℝ) (hs : s ∈ Icc u v) :
      |j₁ (u, s) * Real.exp (-(∫ t in s..v, k₁ (u, t))) -
        j₂ (u, s) * Real.exp (-(∫ t in s..v, k₂ (u, t)))| ≤
        (JΔ + J₀ * KΔ / 2) * (s - u) ^ 2 * D := by
    let q₁ := ∫ t in s..v, k₁ (u, t)
    let q₂ := ∫ t in s..v, k₂ (u, t)
    let e₁ := Real.exp (-q₁)
    let e₂ := Real.exp (-q₂)
    have hq₁pos : 0 ≤ q₁ :=
      intervalIntegral.integral_nonneg hs.2 (fun t ht =>
        hkpos₁ _ ⟨hu, hs.1.trans ht.1, ht.2.trans hv⟩)
    have hq₂pos : 0 ≤ q₂ :=
      intervalIntegral.integral_nonneg hs.2 (fun t ht =>
        hkpos₂ _ ⟨hu, hs.1.trans ht.1, ht.2.trans hv⟩)
    have he₁pos : 0 ≤ e₁ := (Real.exp_pos _).le
    have he₁le : e₁ ≤ 1 := (Real.exp_le_one_iff).2 (neg_nonpos.mpr hq₁pos)
    have hediff : |e₁ - e₂| ≤ KΔ * (v - u) ^ 2 * D / 2 :=
      (abs_exp_neg_sub_exp_neg_le hq₁pos hq₂pos).trans
        (abs_attenuationPrimitive_sub_le hu hs.1 hs.2 hv hk₁ hk₂
          hKΔ hD hkdifference)
    have hj₂bound := hsource₂ _ (hseg s hs)
    have hjdiff := hjdifference _ (hseg s hs)
    have hfirst : |(j₁ (u, s) - j₂ (u, s)) * e₁| ≤
        JΔ * (s - u) ^ 2 * D := by
      rw [abs_mul, abs_of_nonneg he₁pos]
      exact (mul_le_of_le_one_right (abs_nonneg _) he₁le).trans hjdiff
    have hsecond : |j₂ (u, s) * (e₁ - e₂)| ≤
        J₀ * (s - u) ^ 2 * (KΔ * (v - u) ^ 2 * D / 2) := by
      rw [abs_mul, abs_of_nonneg hj₂bound.1]
      exact mul_le_mul hj₂bound.2 hediff (abs_nonneg _)
        (mul_nonneg hJ₀ (sq_nonneg _))
    have hsecond' : J₀ * (s - u) ^ 2 * (KΔ * (v - u) ^ 2 * D / 2) ≤
        J₀ * (s - u) ^ 2 * (KΔ * D / 2) := by
      apply mul_le_mul_of_nonneg_left _ (mul_nonneg hJ₀ (sq_nonneg _))
      nlinarith [mul_nonneg hKΔ hD]
    calc
      _ = |(j₁ (u, s) - j₂ (u, s)) * e₁ + j₂ (u, s) * (e₁ - e₂)| := by
        congr 1
        ring
      _ ≤ |(j₁ (u, s) - j₂ (u, s)) * e₁| + |j₂ (u, s) * (e₁ - e₂)| :=
        abs_add_le _ _
      _ ≤ JΔ * (s - u) ^ 2 * D +
          J₀ * (s - u) ^ 2 * (KΔ * D / 2) := by
        exact add_le_add hfirst (hsecond.trans hsecond')
      _ = _ := by ring
  have hmain := abs_integral_le_third_cube_of_abs_le_quadratic
    (A := (JΔ + J₀ * KΔ / 2) * D) huv
    (hi₁.sub hi₂) (by
      intro s hs
      have h := hpoint s hs
      convert h using 1
      ring)
  have heq : attenuatedVolterraIntegral j₁ k₁ u v -
      attenuatedVolterraIntegral j₂ k₂ u v =
      ∫ s in u..v,
        (j₁ (u, s) * Real.exp (-(∫ t in s..v, k₁ (u, t))) -
         j₂ (u, s) * Real.exp (-(∫ t in s..v, k₂ (u, t)))) := by
    rw [attenuatedVolterraIntegral, attenuatedVolterraIntegral,
      intervalIntegral.integral_sub hi₁ hi₂]
  rw [heq]
  nlinarith only [hmain]

end intervalIntegral

end
